rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper: check if user is admin ───
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isSelfUserUpdate(userId) {
      return isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.currentLeaseId == resource.data.currentLeaseId
        && request.resource.data.currentPropertyId == resource.data.currentPropertyId;
    }

    // ─── Users ───
    match /users/{userId} {
      allow read: if request.auth != null && (isOwner(userId) || isAdmin());
      allow create: if request.auth != null && isOwner(userId);
      allow update: if request.auth != null && (isSelfUserUpdate(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // ─── Properties (admin write, public read for listings) ───
    match /properties/{propId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Applications ───
    match /applications/{appId} {
      allow read: if request.auth != null
        && (resource.data.primaryApplicantId == request.auth.uid || isAdmin());
      allow create: if request.auth != null
        && request.resource.data.primaryApplicantId == request.auth.uid;
      allow update: if request.auth != null
        && (
          isAdmin()
          || (
            resource.data.primaryApplicantId == request.auth.uid
            && request.resource.data.status == 'withdrawn'
            && request.resource.data.primaryApplicantId == resource.data.primaryApplicantId
            && request.resource.data.propertyId == resource.data.propertyId
            && request.resource.data.leaseId == resource.data.leaseId
          )
        );
      allow delete: if isAdmin();
    }

    // ─── Leases ───
    match /leases/{leaseId} {
      allow read: if request.auth != null
        && (
          request.auth.uid in resource.data.tenantIds
          || request.auth.uid == resource.data.tenantUid
          || isAdmin()
        );
      allow write: if isAdmin();
    }

    // ─── Tenants ───
    match /tenants/{tenantId} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // ─── Invoices ───
    match /invoices/{invoiceId} {
      allow read: if request.auth != null
        && (resource.data.tenantUid == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // ─── Payments ───
    match /payments/{paymentId} {
      allow read: if request.auth != null
        && (resource.data.tenantUid == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ─── Rent Statements + Ledger ───
    match /rentStatements/{statementId} {
      allow read: if request.auth != null
        && (resource.data.tenantUid == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;

      match /ledger/{entryId} {
        allow read: if request.auth != null
          && (get(/databases/$(database)/documents/rentStatements/$(statementId)).data.tenantUid == request.auth.uid || isAdmin());
        allow write: if isAdmin();
      }
    }

    // ─── Portal Documents ───
    match /portalDocuments/{docId} {
      allow read: if request.auth != null
        && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if request.auth != null
        && request.resource.data.uploadedByUid == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();

      match /events/{eventId} {
        allow read: if request.auth != null
          && (get(/databases/$(database)/documents/portalDocuments/$(docId)).data.ownerUid == request.auth.uid || isAdmin());
        allow write: if request.auth != null;
      }
    }

    // ─── Maintenance ───
    match /maintenance/{ticketId} {
      allow read: if request.auth != null
        && (
          resource.data.tenantId == request.auth.uid
          || isAdmin()
        );
      allow create: if request.auth != null
        && (
          isAdmin()
          || request.resource.data.tenantId == request.auth.uid
        );
      allow update: if request.auth != null
        && (resource.data.tenantId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ─── Messages & Conversations ───
    match /conversations/{convId} {
      allow read: if request.auth != null
        && (request.auth.uid in resource.data.participantIds || isAdmin());
      allow write: if request.auth != null;
    }

    match /messages/{msgId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ─── Alerts ───
    match /alerts/{alertId} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if request.auth != null;
    }

    // ─── Document Templates ───
    match /documents/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ─── Households ───
    match /households/{hhId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ─── Admin Settings ───
    match /settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ─── Leads ───
    match /leads/{leadId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ─── Tours ───
    match /tours/{tourId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ─── Activity Logs ───
    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow create: if request.auth != null && isAdmin();
      allow update, delete: if false;
    }

    // ─── Lease Templates (admin-only CRUD) ───
    match /leaseTemplates/{templateId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ─── Generated Leases ───
    match /generatedLeases/{genLeaseId} {
      allow read: if request.auth != null
        && (resource.data.tenantUid == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update: if request.auth != null
        && (
          isAdmin()
          || (
            resource.data.tenantUid == request.auth.uid
            && resource.data.signingStatus in ['sent', 'viewed']
            && request.resource.data.signingStatus in ['viewed', 'signed']
            && request.resource.data.tenantUid == resource.data.tenantUid
            && request.resource.data.leaseId == resource.data.leaseId
            && request.resource.data.templateId == resource.data.templateId
          )
        );
      allow delete: if false;
    }

    // ─── Contact Submissions (public site form → admin messages) ───
    match /contactSubmissions/{subId} {
      allow create: if true;                 // Anyone can submit the contact form
      allow read, update, delete: if isAdmin();
    }
  }
}
